{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json"],
  "globalEnv": ["CI", "FORCE_COLOR", "PYTHONHASHSEED", "SOURCE_DATE_EPOCH", "TZ"],
  "globalPassThroughEnv": [
    "REMOTE_SKILLS_PYTHON",
    "REMOTE_SKILLS_E2E_PACKAGES",
    "REMOTE_SKILLS_E2E_CLI",
    "REMOTE_SKILLS_E2E_PYTHON",
    "REMOTE_SKILLS_E2E_CONSUMER",
    "npm_execpath",
    "npm_package_name",
    "GITHUB_OUTPUT"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "check": {
      "dependsOn": ["^check"],
      "cache": false
    },
    "@remote-skills/docs#check": {
      "dependsOn": ["@remote-skills/cli#check"],
      "cache": false
    },
    "test": {
      "dependsOn": ["^build", "^test"],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": []
    }
  }
}
