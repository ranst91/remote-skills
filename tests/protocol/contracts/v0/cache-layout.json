{
  "contract_version": 1,
  "namespace": "cache-v1",
  "origin_identifier": {
    "input": "canonical well-known index URL encoded as UTF-8",
    "algorithm": "sha256 lowercase hex",
    "example_url": "https://skills.example.test/.well-known/agent-skills/index.json",
    "example_identifier": "e396390b2552f0cd92e2bf23ef6af15aedc1d1bb03c6cb2c8ba82d12932b260c",
    "scoped_input": "canonical well-known index URL + LF + remote-skills-scope: + confirmed scope, encoded as UTF-8",
    "scoped_example_scope": "engineering",
    "scoped_example_identifier": "9dc5c74ba396dc5b65ff423600466f65b6d0a1bfca3eb6866345481f98de17a9",
    "persistent_prerequisite": "public unscoped response or configured scope confirmed by matching response header; Cache-Control no-store forbids persistence",
    "forbidden_inputs": ["headers", "credentials", "credential hashes", "URL fragment"]
  },
  "paths": {
    "catalog_body": "catalogs/<origin-sha256>/body.json",
    "catalog_metadata": "catalogs/<origin-sha256>/metadata.json",
    "eviction_metadata": "eviction.json",
    "object_artifact": "objects/sha256/<first-two>/<remaining>/artifact",
    "object_metadata": "objects/sha256/<first-two>/<remaining>/object.json",
    "object_root": "objects/sha256/<first-two>/<remaining>/root/",
    "lease": "leases/<digest>/<process-session-and-lease-nonce>.json",
    "lease_generation": "leases/<digest>/.lease-generation.json",
    "coordination": "tmp/coordination-v1/",
    "mutation_intent": "tmp/coordination-v1/locks/<digest>/<owner-nonce>.intent",
    "mutation_lock": "tmp/coordination-v1/locks/<digest>/<zero-padded-ticket>-<owner-nonce>.lock",
    "process_registration": "tmp/coordination-v1/processes/<digest>/<process-nonce>.json",
    "temporary": "tmp/<private-random-name>/"
  },
  "publication": [
    "create_private_same_filesystem_temporary_path",
    "stream_hash_and_bound_bytes",
    "validate_complete_object",
    "publish_with_no_clobber_atomic_insert",
    "verify_existing_winner_if_insert_lost",
    "discard_private_temporary_path"
  ],
  "metadata_schemas": {
    "catalog": {
      "schema": "remote-skills-catalog-metadata-v1",
