      "types": {
        "schema": "string",
        "pid": "integer",
        "process_nonce": "string",
        "owner_nonce": "string",
        "ticket": "integer",
        "created_at": "timestamp",
        "operation": "string",
        "contended_with_eviction": "boolean"
      }
    },
    "mutation_intent": {
      "schema": "remote-skills-cache-mutation-intent-v1",
      "required": ["schema", "pid", "process_nonce", "owner_nonce", "created_at"],
      "optional": ["operation", "contended_with_eviction"],
      "types": {
        "schema": "string",
        "pid": "integer",
        "process_nonce": "string",
        "owner_nonce": "string",
        "created_at": "timestamp",
        "operation": "string",
        "contended_with_eviction": "boolean"
      }
    },
    "process_registration": {
      "schema": "remote-skills-cache-process-registration-v1",
      "required": ["schema", "pid", "process_nonce", "renewed_at"],
      "optional": ["process_identity"],
      "types": {
        "schema": "string",
        "pid": "integer",
        "process_nonce": "string",
        "process_identity": "string",
        "renewed_at": "timestamp"
      }
    },
    "writer": {
      "schema": "remote-skills-cache-writer-v1",
      "required": [
        "schema",
        "writer",
        "pid",
        "process_nonce",
        "expected_digest",
        "bytes_received",
        "complete"
      ],
      "optional": [],
      "types": {
        "schema": "string",
        "writer": "string",
        "pid": "integer",
        "process_nonce": "string",
        "expected_digest": "digest",
        "bytes_received": "integer",
        "complete": "boolean"
      }
    },
    "eviction": {
      "schema": "remote-skills-eviction-metadata-v1",
      "required": ["schema", "last_run_at", "max_bytes", "max_age_seconds", "candidate_order"],
      "optional": [],
      "types": {
        "schema": "string",
        "last_run_at": "timestamp",
        "max_bytes": "integer",
        "max_age_seconds": "integer",
        "candidate_order": "string_array"
      }
    }
  },
  "lease_expiry": "conservative age plus the shared digest-scoped process registration and operating-system process identity check",
  "coordination_lifecycle": [
    "atomically_create_or_replace_one_digest_scoped_registration_per_process_nonce",
    "heartbeat_renewed_at_while_a_lease_or_writer_for_that_digest_is_active",
    "writer_process_nonce_must_reference_the_same_digest_registration",
    "remove_the_registration_after_the_final_owned_lease_or_writer_ends",
    "new_lease_handles_include_a_unique_persisted_lease_nonce",
    "reclaim_orphan_process_registrations_without_a_lease_writer_or_object",
    "remove_orphan_lease_generation_records_and_empty_coordination_directories",
    "reclaim_expired_registration_and_generation_records_only_after_liveness_recheck",
    "bind_every_cleanup_unlink_to_the_observed_record_and_parent_generation",
    "bound_every_coordination_scan_and_record_size",
    "publish_a_live_process_registration_before_any_mutation_intent_or_lock_record",
    "elect_mutation_owners_with_bounded_lamport_bakery_intents_and_integer_tickets",
    "retain_each_mutation_intent_until_its_ticket_and_critical_section_are_released",
    "anchor_object_generation_identity_with_retained_no_follow_directory_chain_before_announcing_a_lease_acquisition",
    "reject_before_lease_publication_if_an_observed_object_generation_was_removed",
    "persist_an_observed_predecessor_eviction_handoff_in_the_successor_ticket_generation",
    "use_generation_unique_owner_paths_that_are_never_reused_by_a_successor",
    "serialize_each_digest_lease_acquisition_against_final_eviction_pin_check_through_removal",
    "acquire_the_shared_mutation_lock_before_any_runtime_compatibility_lock_and_release_in_reverse_order",
    "reject_an_acquisition_that_contended_with_a_winning_eviction_instead_of_returning_a_handle_to_a_removed_object"
  ],
  "fixture_evaluation_inputs": {
    "required": ["schema", "now", "lease_expiry_seconds", "process_liveness"],
    "schema": "remote-skills-cache-evaluation-inputs-v1"
  },
  "metadata_forbidden_fields": [
    "headers",
    "authorization",
    "cookie",
    "query",
    "fragment",
    "requested_scope",
    "artifact_body"
  ]
}
