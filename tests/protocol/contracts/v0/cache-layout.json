        "canonical_url": "sanitized_url",
        "retrieved_at": "timestamp",
        "validated_at": "timestamp",
        "etag": "string",
        "last_modified": "string",
        "cache_control": "string",
        "confirmed_scope": "string"
      }
    },
    "object": {
      "schema": "remote-skills-object-metadata-v1",
      "required": [
        "schema",
        "digest",
        "artifact_type",
        "archive_format",
        "artifact_bytes",
        "extracted_bytes",
        "files",
        "verified_at",
        "accessed_at"
      ],
      "optional": [],
      "types": {
        "schema": "string",
        "digest": "digest",
        "artifact_type": "string",
        "archive_format": "nullable_string",
        "artifact_bytes": "integer",
        "extracted_bytes": "integer",
        "files": "extraction_file_array",
        "verified_at": "timestamp",
        "accessed_at": "timestamp"
      }
    },
    "extraction_file": {
      "required": ["path", "size", "media_type"],
      "optional": [],
      "types": { "path": "normalized_path", "size": "integer", "media_type": "string" }
    },
    "lease": {
      "schema": "remote-skills-cache-lease-v1",
      "required": [
        "schema",
        "digest",
        "pid",
        "process_nonce",
        "session_nonce",
        "lease_nonce",
        "created_at",
        "renewed_at"
      ],
      "optional": [],
      "types": {
        "schema": "string",
        "digest": "digest",
        "pid": "integer",
        "process_nonce": "string",
        "session_nonce": "string",
        "lease_nonce": "string",
        "created_at": "timestamp",
        "renewed_at": "timestamp"
      }
    },
    "lease_generation": {
      "schema": "remote-skills-cache-lease-generation-v1",
      "required": ["schema", "coordination_version", "generation"],
      "optional": [],
      "types": {
        "schema": "string",
        "coordination_version": "string",
        "generation": "timestamp"
      }
    },
