{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "uv:sync": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uv.lock",
        "$TURBO_ROOT$/pyproject.toml",
        "pyproject.toml"
      ],
      "outputs": [],
      "cache": false
    },
    "uv:typecheck": {
      "dependsOn": ["uv:sync"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uv.lock",
        "$TURBO_ROOT$/pyproject.toml",
        "pyproject.toml"
      ],
      "outputs": [],
      "cache": false
    },
    "uv:test": {
      "dependsOn": ["uv:sync"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uv.lock",
        "$TURBO_ROOT$/pyproject.toml",
        "pyproject.toml"
      ],
      "outputs": [],
      "cache": false
    },
    "typecheck": {
      "dependsOn": ["uv:sync"]
    },
    "test": {
      "dependsOn": ["uv:sync"]
    }
  }
}
