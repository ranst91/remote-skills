{
  "name": "@remote-skills/tanstack-ai",
  "version": "0.0.1-alpha.0",
  "description": "Verified remote SkillSource for TanStack AI's native skill loader.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@remote-skills/client": "^0.0.1-alpha.0",
    "@tanstack/ai-skills": "0.1.4"
  },
  "devDependencies": {
    "@remote-skills/client": "workspace:*",
    "@tanstack/ai-skills": "0.1.4",
    "@tanstack/ai": "0.55.0",
    "zod": "4.3.6",
    "vitest": "4.1.10",
    "@types/node": "24.13.3",
    "typescript": "catalog:",
    "vite": "8.2.2",
    "esbuild": "0.28.2",
    "jiti": "2.7.0",
    "yaml": "2.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test tests/*.test.ts && vitest run tests/conformance.spec.ts",
    "check": "pnpm typecheck && pnpm test",
    "pack:local": "node scripts/pack-local.ts",
    "package:check": "node scripts/check-package.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ranst91/remote-skills.git",
    "directory": "integrations/tanstack-ai"
  }
}
